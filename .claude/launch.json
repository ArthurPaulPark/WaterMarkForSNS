{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "watermark",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "server.py"
      ],
      "port": 8765
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
